# Just One More — environment variables (names only, never real values).
#
# Add each key here, with an empty value, in the same change that first reads it.
# Client-visible keys must be prefixed NEXT_PUBLIC_ (SECURITY.md §2); everything else is
# server-only and is blocked from 'use client' modules by the jom/no-private-env-in-client
# ESLint rule.

# --- Realtime / party play (Phase 5) ---
# apps/web (client-visible): the Colyseus server's WebSocket URL, e.g. wss://… in production.
# Unset on localhost, the web app uses ws://localhost:2567.
NEXT_PUBLIC_REALTIME_URL=
# apps/realtime: port to listen on (default 2567).
PORT=
# apps/realtime: set to 1 only behind a proxy that sets X-Forwarded-For (Railway, Fly).
TRUST_PROXY=
